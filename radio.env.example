# Copy to radio.env and customize for your Pi:
#   cp radio.env.example radio.env

# Web UI (started with service_mode.py / start_radio.sh)
RADIO_WEB_ENABLED=1
RADIO_WEB_HOST=0.0.0.0
RADIO_WEB_PORT=5000

# --- Display ---
RADIO_DISPLAY_ENABLED=1

# Type: ssd1306 | st7735 | st7789 — OR use framebuffer (plan):
# DISPLAY_FB=/dev/fb1
RADIO_DISPLAY_TYPE=st7735

# SPI TFT (ST7735 / ST7789) — adjust for your board
DISPLAY_SPI_PORT=0
DISPLAY_SPI_DEVICE=0
DISPLAY_GPIO_DC=23
DISPLAY_GPIO_RST=24
DISPLAY_WIDTH=128
DISPLAY_HEIGHT=160
DISPLAY_ROTATE=0
# Most 1.8" TFT hats need BGR=1 or text/colors look wrong
DISPLAY_BGR=1

# I2C OLED (SSD1306 only)
# RADIO_DISPLAY_TYPE=ssd1306
# DISPLAY_I2C_ADDRESS=0x3C
# DISPLAY_I2C_PORT=1

# Optional: TrueType font path on Pi
# DISPLAY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

RADIO_DISPLAY_INTERVAL=3

# GPIO buttons — only if wired; needs requirements-pi.txt
# RADIO_GPIO_ENABLED=1

STATION_LIMIT=25
