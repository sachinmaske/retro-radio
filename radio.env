# Copy to radio.env and customize for your Pi:
#   cp radio.env.example radio.env

# Web UI (started with service_mode.py / start_radio.sh)
RADIO_WEB_ENABLED=1
RADIO_WEB_HOST=0.0.0.0
RADIO_WEB_PORT=5050
RETRO_RADIO_DIR=/Users/sachin/Workspace/retro-radio

# OLED (I2C SSD1306) or TFT (SPI ST7735)
RADIO_DISPLAY_ENABLED=1
RADIO_DISPLAY_TYPE=ssd1306
# RADIO_DISPLAY_TYPE=st7735
DISPLAY_I2C_ADDRESS=0x3C
DISPLAY_I2C_PORT=1

# GPIO buttons — only if wired; needs requirements-pi.txt
# RADIO_GPIO_ENABLED=1
# Leave unset or 0 if you do not use physical buttons

# Station list size (lower = less RAM on Pi B+)
STATION_LIMIT=25
